<header><h1>💧 Agua Reparto</h1><p>Clientes, entregas, cobros y cuentas</p></header><main class="wrap"><div class="stats"><div class="stat"><small>Clientes</small><strong id="sClientes">0</strong></div><div class="stat"><small>Bidones entregados</small><strong id="sBidones">0</strong></div><div class="stat"><small>Total adeudado</small><strong id="sDeuda">$0</strong></div></div>
<nav class="tabs"><button type="button" class="tab active" data-tab="clientes">Clientes</button><button type="button" class="tab" data-tab="movimientos">Entregas / Cobros</button><button type="button" class="tab" data-tab="historial">Historial</button><button type="button" class="tab" data-tab="backup">Respaldo</button></nav>
<section class="section active" id="clientes"><div class="panel"><h2>Agregar cliente</h2><div class="formgrid"><div><label for="nombre">Nombre</label><input id="nombre" placeholder="Nombre del cliente"></div><div><label for="telefono">Teléfono (opcional)</label><input id="telefono" placeholder="Teléfono"></div><div><label for="direccion">Dirección</label><input id="direccion" placeholder="Dirección"></div><div><label for="precio">Precio por bidón ($)</label><input id="precio" type="number" min="0" value=""></div></div><div class="actions"><button type="button" data-action="add-client">Guardar cliente</button></div></div><div class="panel" style="margin-top:12px"><h2>Lista de clientes</h2><input class="search" id="buscar" placeholder="Buscar cliente..."><div id="listaClientes"></div></div></section>
<section class="section" id="movimientos"><div class="panel"><h2>Registrar movimiento</h2><div class="formgrid"><div><label for="movCliente">Cliente</label><select id="movCliente"></select></div><div><label for="tipo">Tipo</label><select id="tipo"><option value="entrega">Entrega de bidones</option><option value="devolucion">Devolución de envases</option><option value="pago">Cobro / Pago</option></select></div><div><label for="cantidad">Cantidad de bidones</label><input id="cantidad" type="number" min="1" value="1"></div><div><label for="monto">Monto ($) (para cobro)</label><input id="monto" type="number" min="0" placeholder="Monto cobrado"></div><div><label for="fecha">Fecha</label><input id="fecha" type="date"></div><div><label for="nota">Nota (opcional)</label><input id="nota" placeholder="Observación"></div></div><div class="actions"><button type="button" data-action="add-movement">Guardar movimiento</button></div><p class="muted small">En una entrega se calcula el importe. En una devolución solo se contabilizan envases retornados. En un cobro, ingresá el monto recibido.</p></div></section>
<section class="section" id="historial"><div class="panel"><h2>Historial</h2><select id="filtroHist"><option value="">Todos los clientes</option></select><div id="listaHist"></div></div></section>
<section class="section" id="backup"><div class="panel"><h2>Respaldo de datos</h2><p>Exportá una copia de tus clientes y movimientos. Si cambiás de celular, podés importar el archivo.</p><div class="actions"><button type="button" data-action="export">Descargar respaldo</button><button type="button" class="secondary" data-action="import-trigger">Importar respaldo</button><input id="importFile" class="hidden" type="file" accept=".json,application/json"></div><p class="muted small">Los datos se guardan en este dispositivo y navegador. Exportá copias regularmente.</p><hr><button type="button" class="danger" data-action="erase-all">Borrar todos los datos</button></div></section>
<div class="foot">Agua Reparto · Datos guardados localmente en tu dispositivo</div></main>
<div id="appModal" class="modal hidden" role="dialog" aria-modal="true"><div class="modalbox"><h2 id="modalTitle">Confirmar</h2><p id="modalText"></p><div id="modalInputWrap" class="hidden"><label for="modalInput" id="modalInputLabel">Precio</label><input id="modalInput" type="number" min="0" inputmode="decimal"></div><div class="actions"><button type="button" class="secondary" data-action="modal-cancel">Cancelar</button><button type="button" class="danger" id="modalOk" data-action="modal-ok">Confirmar</button></div></div></div>
<style>.modal{position:fixed;inset:0;background:#0008;display:flex;align-items:center;justify-content:center;padding:18px;z-index:9999}.modal.hidden{display:none!important}.modalbox{background:#fff;color:#123047;width:min(440px,100%);padding:20px;border-radius:16px;box-shadow:0 12px 40px #0004}.modalbox h2{margin-bottom:10px}.modalbox p{line-height:1.5}.modalbox input{margin-top:5px}</style>
<script>
'use strict';
(()=>{
const $=id=>document.getElementById(id);const KEYC='ar_clientes',KEYM='ar_movs';
let clientes=[],movs=[];
try{clientes=JSON.parse(localStorage.getItem(KEYC)||'[]');if(!Array.isArray(clientes))clientes=[];}catch(_){clientes=[]}
try{movs=JSON.parse(localStorage.getItem(KEYM)||'[]');if(!Array.isArray(movs))movs=[];}catch(_){movs=[]}
const money=n=>'$'+Number(n||0).toLocaleString('es-AR',{maximumFractionDigits:2});
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const saldo=c=>movs.filter(m=>String(m.cid)===String(c.id)).reduce((s,m)=>s+(m.tipo==='entrega'?Number(m.total||0):-Number(m.monto||0)),0);
const totalEntregados=()=>movs.filter(m=>m.tipo==='entrega').reduce((s,m)=>s+Number(m.cantidad||0),0);
const envasesPendientes=c=>movs.filter(m=>String(m.cid)===String(c.id)).reduce((s,m)=>s+(m.tipo==='entrega'?Number(m.cantidad||0):m.tipo==='devolucion'?-Number(m.cantidad||0):0),0);
const totalDevoluciones=()=>movs.filter(m=>m.tipo==='devolucion').reduce((s,m)=>s+Number(m.cantidad||0),0);
function save(){localStorage.setItem(KEYC,JSON.stringify(clientes));localStorage.setItem(KEYM,JSON.stringify(movs));render();}
function addCliente(){const n=$('nombre').value.trim();if(!n){alert('Ingresá el nombre del cliente.');$('nombre').focus();return;}const p=Number($('precio').value||0);if(!Number.isFinite(p)||p<0){alert('Precio inválido.');return;}clientes.push({id:'c'+Date.now()+Math.random().toString(16).slice(2),nombre:n,telefono:$('telefono').value.trim(),direccion:$('direccion').value.trim(),precio:p});['nombre','telefono','direccion','precio'].forEach(x=>$(x).value='');save();}
function addMovimiento(){const cid=$('movCliente').value;if(!cid){alert('Agregá primero un cliente.');return;}const c=clientes.find(x=>String(x.id)===String(cid));if(!c){alert('No se encontró el cliente.');return;}const tipo=$('tipo').value,fecha=$('fecha').value||new Date().toISOString().slice(0,10),nota=$('nota').value.trim();const m={id:'m'+Date.now()+Math.random().toString(16).slice(2),cid,tipo,fecha,nota};if(tipo==='entrega'||tipo==='devolucion'){const cant=Number($('cantidad').value);if(!Number.isFinite(cant)||cant<1){alert('La cantidad debe ser al menos 1.');return;}m.cantidad=Math.floor(cant);if(tipo==='entrega')m.total=m.cantidad*Number(c.precio||0);if(tipo==='devolucion'&&m.cantidad>envasesPendientes(c)){alert('La devolución no puede superar los envases pendientes del cliente.');return;}}else{m.monto=Number($('monto').value||0);if(!Number.isFinite(m.monto)||m.monto<=0){alert('Ingresá un monto válido.');return;}}movs.push(m);$('nota').value='';$('monto').value='';$('cantidad').value='1';save();}
let modalAction=null;function showModal(title,message,inputMode,initial,callback){$('modalTitle').textContent=title;$('modalText').textContent=message;$('modalInputWrap').classList.toggle('hidden',!inputMode);$('modalInput').value=initial??'';$('modalOk').textContent=inputMode?'Guardar':'Eliminar';modalAction=callback;$('appModal').classList.remove('hidden');if(inputMode)setTimeout(()=> $('modalInput').focus(),50);}function closeModal(){$('appModal').classList.add('hidden');modalAction=null;}
function delCliente(id){const c=clientes.find(x=>String(x.id)===String(id));if(!c)return;showModal('Eliminar cliente','¿Eliminar '+c.nombre+' y todos sus movimientos?',false,null,()=>{clientes=clientes.filter(x=>String(x.id)!==String(id));movs=movs.filter(m=>String(m.cid)!==String(id));closeModal();save();});}
function delMov(id){if(!movs.some(m=>String(m.id)===String(id)))return;showModal('Eliminar movimiento','¿Querés eliminar este movimiento?',false,null,()=>{movs=movs.filter(m=>String(m.id)!==String(id));closeModal();save();});}
function editarPrecio(id){const c=clientes.find(x=>String(x.id)===String(id));if(!c)return;showModal('Cambiar precio','Nuevo precio por bidón para '+c.nombre,true,String(c.precio),()=>{let p=$('modalInput').value.trim().replace(',','.');if(p===''||!Number.isFinite(Number(p))||Number(p)<0){$('modalText').textContent='Ingresá un precio válido (0 o mayor).';return;}c.precio=Number(p);closeModal();save();});}
function render(){ $('sClientes').textContent=clientes.length;$('sBidones').textContent=totalEntregados();$('sDeuda').textContent=money(clientes.reduce((s,c)=>s+saldo(c),0));const q=$('buscar').value.toLowerCase();$('listaClientes').innerHTML=clientes.filter(c=>(String(c.nombre)+' '+String(c.direccion||'')).toLowerCase().includes(q)).map(c=>`<div class="item"><div class="row"><div><strong>${esc(c.nombre)}</strong><div class="muted">${esc(c.direccion||'Sin dirección')} · ${esc(c.telefono||'Sin teléfono')}</div><div class="muted">Precio/bidón: ${money(c.precio)}</div><div class="muted">Envases pendientes: <strong>${envasesPendientes(c)}</strong></div><div class="muted">Entregados: ${movs.filter(m=>String(m.cid)===String(c.id)&&m.tipo==='entrega').reduce((s,m)=>s+Number(m.cantidad||0),0)} · Devueltos: ${movs.filter(m=>String(m.cid)===String(c.id)&&m.tipo==='devolucion').reduce((s,m)=>s+Number(m.cantidad||0),0)}</div></div><div style="text-align:right"><div class="amount">Saldo: ${money(saldo(c))}</div><button type="button" class="secondary small" data-action="price" data-id="${esc(c.id)}">Cambiar precio</button> <button type="button" class="danger small" data-action="delete-client" data-id="${esc(c.id)}">Eliminar</button></div></div></div>`).join('')||'<div class="empty">Todavía no hay clientes.</div>';const opts=clientes.map(c=>`<option value="${esc(c.id)}">${esc(c.nombre)}</option>`).join('');$('movCliente').innerHTML=opts||'<option value="">Agregá clientes primero</option>';$('filtroHist').innerHTML='<option value="">Todos los clientes</option>'+opts;renderHist();}
function renderHist(){const f=$('filtroHist').value;const arr=movs.filter(m=>!f||String(m.cid)===String(f)).slice().sort((a,b)=>String(b.fecha).localeCompare(String(a.fecha)));$('listaHist').innerHTML=arr.map(m=>{const c=clientes.find(x=>String(x.id)===String(m.cid));return `<div class="item"><div class="row"><div><strong>${esc(c?.nombre||'Cliente eliminado')}</strong><div class="muted">${esc(m.fecha)} · ${m.tipo==='entrega'?'Entrega':m.tipo==='devolucion'?'Devolución de envases':'Cobro'}${m.nota?' · '+esc(m.nota):''}</div>${m.tipo==='entrega'||m.tipo==='devolucion'?`<div>${Number(m.cantidad||0)} envase(s) ${m.tipo==='entrega'?'entregados':'devueltos'}</div>`:''}</div><div style="text-align:right"><div class="amount" style="color:${m.tipo==='entrega'?'#b45c00':m.tipo==='devolucion'?'#087eae':'#198754'}">${m.tipo==='entrega'?'+ '+money(m.total):m.tipo==='devolucion'?'Envases devueltos':'- '+money(m.monto)}</div><button type="button" class="danger small" data-action="delete-movement" data-id="${esc(m.id)}">Eliminar</button></div></div></div>`}).join('')||'<div class="empty">No hay movimientos registrados.</div>';}
function exportar(){const data={version:1,exportado:new Date().toISOString(),clientes,movs};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='respaldo_agua_reparto.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
function importar(file){if(!file)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!Array.isArray(d.clientes)||!Array.isArray(d.movs))throw new Error('Formato inválido');if(!confirm('¿Reemplazar los datos actuales con los del respaldo?'))return;clientes=d.clientes;movs=d.movs;save();alert('Respaldo importado correctamente.');}catch(_){alert('El archivo no es un respaldo válido de Agua Reparto.');}};r.onerror=()=>alert('No se pudo leer el archivo.');r.readAsText(file);}
function borrarTodo(){showModal('Borrar datos','¿Seguro que querés borrar todos los clientes y movimientos? Esta acción no se puede deshacer.',false,null,()=>{clientes=[];movs=[];closeModal();save();});}
function switchTab(tab){const sec=$(tab);if(!sec)return;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('.section').forEach(s=>s.classList.toggle('active',s.id===tab));}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.tab){switchTab(b.dataset.tab);return;}const action=b.dataset.action;if(!action)return;switch(action){case'modal-cancel':closeModal();break;case'modal-ok':if(modalAction)modalAction();break;case'add-client':addCliente();break;case'add-movement':addMovimiento();break;case'delete-client':delCliente(b.dataset.id);break;case'price':editarPrecio(b.dataset.id);break;case'delete-movement':delMov(b.dataset.id);break;case'export':exportar();break;case'import-trigger':$('importFile').click();break;case'erase-all':borrarTodo();break;}});
$('buscar').addEventListener('input',render);$('filtroHist').addEventListener('change',renderHist);$('importFile').addEventListener('change',e=>{importar(e.target.files[0]);e.target.value='';});$('tipo').addEventListener('change',()=>{$('cantidad').disabled=$('tipo').value==='pago';$('monto').disabled=$('tipo').value!=='pago';});$('fecha').value=new Date().toISOString().slice(0,10);$('monto').disabled=true;render();
})();
</script><script>

:root{--blue:#087eae;--dark:#123047;--bg:#eef5f8;--card:#fff;--green:#198754;--red:#c0392b}*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--dark)}header{background:linear-gradient(120deg,#087eae,#25a6d2);color:white;padding:22px 18px}header h1{margin:0;font-size:1.5rem}header p{margin:4px 0 0;opacity:.9}.wrap{max-width:1000px;margin:auto;padding:14px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}.stat,.panel{background:var(--card);border-radius:14px;padding:14px;box-shadow:0 3px 12px #18364b0d}.stat small{display:block;color:#678;font-size:.85rem}.stat strong{font-size:1.35rem}.tabs{display:flex;gap:8px;overflow:auto;margin-bottom:12px}.tabs button{white-space:nowrap}.tab{border:0;background:white;border-radius:999px;padding:10px 15px;font-weight:700;color:var(--dark)}.tab.active{background:var(--blue);color:white}button{cursor:pointer;border:0;border-radius:9px;background:var(--blue);color:white;padding:10px 13px;font-weight:650}button.secondary{background:#e7f1f5;color:var(--dark)}button.danger{background:var(--red)}input,select,textarea{color:#000!important;width:100%;padding:11px;border:1px solid #cbd8e0;border-radius:9px;font:inherit;background:white}input::placeholder,textarea::placeholder{color:#555;opacity:1}input:disabled,select:disabled{color:#000!important;opacity:1}label{font-size:.9rem;font-weight:650;display:block;margin-bottom:5px}.formgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.section{display:none}.section.active{display:block}.row{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}.item{padding:12px 0;border-bottom:1px solid #e5edf1}.item:last-child{border:0}.muted{color:#66808e;font-size:.9rem}.amount{font-weight:800}.search{margin:10px 0}.empty{padding:22px;text-align:center;color:#789}.small{font-size:.85rem}.foot{color:#678;font-size:.8rem;text-align:center;padding:16px}.hidden{display:none!important}h2{font-size:1.2rem;margin:0 0 12px}
